{{ 'bb-styles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bb-scripts.js' | asset_url }}" defer></script>

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    {% if section.settings.bg_color != blank %}background: {{ section.settings.bg_color }};{% endif %}
  }
  #shopify-section-{{ section.id }} .bb-h2 { font-size: {{ section.settings.heading_size }}px; }

  #shopify-section-{{ section.id }} .bb-testi__rail-wrap {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  #shopify-section-{{ section.id }} .bb-testi__rail {
    display: flex;
    gap: clamp(14px, 2vw, 22px);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    list-style: none;
    margin: 0;
    padding: 4px 4px 8px;
    flex: 1;
  }
  #shopify-section-{{ section.id }} .bb-testi__rail::-webkit-scrollbar { display: none; }

  #shopify-section-{{ section.id }} .bb-testi__card {
    position: relative;
    flex: 0 0 auto;
    width: clamp(260px, 32vw, 360px);
    scroll-snap-align: start;
    background: #ffffff;
    border: 1px solid var(--bb-line);
    border-radius: var(--bb-radius-sm);
    padding: 26px 26px 24px;
    box-shadow: var(--bb-shadow-sm);
    transition: transform 0.35s var(--bb-ease), box-shadow 0.35s var(--bb-ease), border-color 0.35s var(--bb-ease);
  }
  #shopify-section-{{ section.id }} .bb-testi__card:hover {
    transform: translateY(-4px);
    box-shadow: var(--bb-shadow);
    border-color: rgba(123, 94, 199, 0.28);
  }
  #shopify-section-{{ section.id }} .bb-testi__mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--bb-primary-soft);
    color: var(--bb-primary-deep);
    margin-bottom: 16px;
  }
  #shopify-section-{{ section.id }} .bb-testi__mark svg { width: 15px; height: 15px; }
  #shopify-section-{{ section.id }} .bb-testi__stars {
    position: relative;
    display: flex;
    gap: 2px;
    color: var(--bb-star);
  }
  #shopify-section-{{ section.id }} .bb-testi__stars svg { width: 13px; height: 13px; }
  #shopify-section-{{ section.id }} .bb-testi__text {
    position: relative;
    margin: 12px 0 20px;
    font: 400 15px/1.65 var(--bb-sans);
    color: var(--bb-ink);
  }
  #shopify-section-{{ section.id }} .bb-testi__who {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 18px;
    border-top: 1px solid var(--bb-line);
  }
  #shopify-section-{{ section.id }} .bb-testi__avatar {
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--bb-primary-soft);
    color: var(--bb-primary-deep);
    display: flex;
    align-items: center;
    justify-content: center;
    font: 700 14px/1 var(--bb-serif);
  }
  #shopify-section-{{ section.id }} .bb-testi__avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #shopify-section-{{ section.id }} .bb-testi__who-text { display: flex; flex-direction: column; gap: 1px; }
  #shopify-section-{{ section.id }} .bb-testi__name { font: 600 13.5px/1.3 var(--bb-sans); color: var(--bb-ink); }
  #shopify-section-{{ section.id }} .bb-testi__role { font: 400 12px/1.3 var(--bb-sans); color: var(--bb-ink-soft); }

  #shopify-section-{{ section.id }} .bb-testi__nav {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--bb-line);
    background: #ffffff;
    color: var(--bb-ink);
    cursor: pointer;
    transition: background 0.3s var(--bb-ease), color 0.3s var(--bb-ease), border-color 0.3s var(--bb-ease);
  }
  #shopify-section-{{ section.id }} .bb-testi__nav:hover {
    background: var(--bb-primary);
    border-color: var(--bb-primary);
    color: #fff;
  }
  #shopify-section-{{ section.id }} .bb-testi__nav svg { width: 15px; height: 15px; }

  @media (max-width: 700px) {
    #shopify-section-{{ section.id }} .bb-h2 { font-size: {{ section.settings.heading_size | times: 0.8 | round }}px; }
    #shopify-section-{{ section.id }} .bb-testi__nav { display: none; }
    #shopify-section-{{ section.id }} .bb-testi__card { width: 82vw; padding: 28px 20px 22px; }
  }
{% endstyle %}

<section class="bb-testi bb-section">
  <div class="bb-container">
    <div class="bb-head bb-reveal">
      <div class="bb-head__title">
        {%- if section.settings.eyebrow != blank -%}
          <span class="bb-eyebrow bb-eyebrow--plain">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 class="bb-h2">{{ section.settings.heading }}</h2>
      </div>
    </div>

    <div class="bb-testi__rail-wrap">
      <button type="button" class="bb-testi__nav bb-testi__nav--prev" aria-label="{{ 'general.slider.previous_slide' | t }}" data-bb-testi-prev>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
      </button>

      <ul class="bb-testi__rail" data-bb-testi-rail>
        {%- for block in section.blocks -%}
          <li class="bb-testi__card bb-reveal" {{ block.shopify_attributes }}>
            <span class="bb-testi__mark" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M9.5 6C6.5 7.3 5 9.6 5 12.8c0 2.3 1.3 3.7 3 3.7 1.5 0 2.6-1.1 2.6-2.6 0-1.4-1-2.4-2.3-2.4-.2 0-.4 0-.5.1.3-1.6 1.4-2.9 3-3.6L9.5 6zm8.7 0c-3 1.3-4.5 3.6-4.5 6.8 0 2.3 1.3 3.7 3 3.7 1.5 0 2.6-1.1 2.6-2.6 0-1.4-1-2.4-2.3-2.4-.2 0-.4 0-.5.1.3-1.6 1.4-2.9 3-3.6L18.2 6z"/></svg>
            </span>
            {%- if block.settings.rating > 0 -%}
              <div class="bb-testi__stars" aria-hidden="true">
                {%- for i in (1..5) -%}
                  {%- if i <= block.settings.rating -%}
                    <svg viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.6 5.6 6.1.7-4.5 4.2 1.2 6-5.4-3-5.4 3 1.2-6-4.5-4.2 6.1-.7z"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M10 1.5l2.6 5.6 6.1.7-4.5 4.2 1.2 6-5.4-3-5.4 3 1.2-6-4.5-4.2 6.1-.7z"/></svg>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}
            <p class="bb-testi__text">{{ block.settings.quote }}</p>
            <div class="bb-testi__who">
              <span class="bb-testi__avatar">
                {%- if block.settings.avatar != blank -%}
                  <img src="{{ block.settings.avatar | image_url: width: 120 }}" alt="{{ block.settings.name | escape }}" loading="lazy" width="40" height="40">
                {%- else -%}
                  {{ block.settings.name | slice: 0, 1 }}
                {%- endif -%}
              </span>
              <span class="bb-testi__who-text">
                <span class="bb-testi__name">{{ block.settings.name }}</span>
                {%- if block.settings.role != blank -%}<span class="bb-testi__role">{{ block.settings.role }}</span>{%- endif -%}
              </span>
            </div>
          </li>
        {%- endfor -%}
      </ul>

      <button type="button" class="bb-testi__nav bb-testi__nav--next" aria-label="{{ 'general.slider.next_slide' | t }}" data-bb-testi-next>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
      </button>
    </div>
  </div>
</section>

<script>
  (function () {
    var SID = {{ section.id | json }};
    var root = document.getElementById('shopify-section-' + SID);
    if (!root) return;
    var rail = root.querySelector('[data-bb-testi-rail]');
    var prev = root.querySelector('[data-bb-testi-prev]');
    var next = root.querySelector('[data-bb-testi-next]');
    if (!rail) return;

    function step(dir) {
      var card = rail.querySelector('.bb-testi__card');
      var amount = card ? card.getBoundingClientRect().width + 20 : rail.clientWidth * 0.8;
      rail.scrollBy({ left: amount * dir, behavior: 'smooth' });
    }

    /* hide the nav arrows when there's nothing to scroll to */
    function syncNav() {
      var canScroll = rail.scrollWidth - rail.clientWidth > 8;
      if (prev) prev.hidden = !canScroll;
      if (next) next.hidden = !canScroll;
    }
    syncNav();
    window.addEventListener('resize', syncNav, { passive: true });

    if (prev) prev.addEventListener('click', function () { step(-1); });
    if (next) next.addEventListener('click', function () { step(1); });
  })();
</script>

{% schema %}
{
  "name": "BB — Testimonials",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (small label above heading)", "default": "Loved by our customers" },
    { "type": "text", "id": "heading", "label": "Section heading", "default": "What people are saying" },
    { "type": "range", "id": "heading_size", "label": "Heading size (px)", "min": 20, "max": 60, "step": 2, "unit": "px", "default": 34 },
    { "type": "color", "id": "bg_color", "label": "Section background", "default": "#F6F1FB" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Space above (px)", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Space below (px)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "I get compliments every single time I wear my Bubble Box pieces. The quality is so much better than I expected." },
        { "type": "range", "id": "rating", "label": "Rating", "min": 0, "max": 5, "step": 1, "default": 5 },
        { "type": "image_picker", "id": "avatar", "label": "Avatar (optional)" },
        { "type": "text", "id": "name", "label": "Name", "default": "Sofia R." },
        { "type": "text", "id": "role", "label": "Role / location", "default": "Verified buyer" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "BB — Testimonials",
      "blocks": [
        { "type": "review", "settings": { "quote": "I get compliments every single time I wear my Bubble Box pieces. The quality is so much better than I expected.", "name": "Sofia R.", "role": "Verified buyer", "rating": 5 } },
        { "type": "review", "settings": { "quote": "The bangle box made the perfect gift — my sister loved unboxing every piece. Will be ordering again for myself.", "name": "Camila G.", "role": "Verified buyer", "rating": 5 } },
        { "type": "review", "settings": { "quote": "Fast shipping, beautiful packaging, and the bracelets stack perfectly together. Exactly what I wanted.", "name": "Valentina M.", "role": "Verified buyer", "rating": 5 } }
      ]
    }
  ]
}
{% endschema %}
