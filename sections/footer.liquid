{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{{ 'bb-styles.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} { margin-top: {{ section.settings.margin_top }}px; }
  #shopify-section-{{ section.id }} .bb-footer__grid {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<footer class="bb-footer bb-section">
  <div class="bb-container">
    <div class="bb-footer__grid">

      <div class="bb-footer__brand">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | image_url: width: 320 }}" alt="{{ shop.name | escape }}"
               width="160" style="max-width: {{ section.settings.logo_width }}px; height: auto;" loading="lazy">
        {%- else -%}
          <p class="bb-footer__logo">{{ section.settings.logo_text | default: 'Bubble Beads' }}</p>
        {%- endif -%}
        {%- if section.settings.tagline != blank -%}
          <p class="bb-footer__tag">{{ section.settings.tagline | newline_to_br }}</p>
        {%- endif -%}
        {%- if section.settings.show_social -%}
          <div class="bb-footer__social">
            {%- if settings.social_instagram_link != blank -%}<a href="{{ settings.social_instagram_link }}" aria-label="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.3 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.3 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.3-2.2-.4a3.7 3.7 0 0 1-1.4-.9 3.7 3.7 0 0 1-.9-1.4c-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.3-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2Zm0 1.8c-3.1 0-3.5 0-4.7.1-1.1.1-1.7.2-2.1.4-.5.2-.9.4-1.3.8-.4.4-.6.8-.8 1.3-.2.4-.3 1-.4 2.1-.1 1.2-.1 1.6-.1 4.7s0 3.5.1 4.7c.1 1.1.2 1.7.4 2.1.2.5.4.9.8 1.3.4.4.8.6 1.3.8.4.2 1 .3 2.1.4 1.2.1 1.6.1 4.7.1s3.5 0 4.7-.1c1.1-.1 1.7-.2 2.1-.4.5-.2.9-.4 1.3-.8.4-.4.6-.8.8-1.3.2-.4.3-1 .4-2.1.1-1.2.1-1.6.1-4.7s0-3.5-.1-4.7c-.1-1.1-.2-1.7-.4-2.1a3.5 3.5 0 0 0-.8-1.3 3.5 3.5 0 0 0-1.3-.8c-.4-.2-1-.3-2.1-.4-1.2-.1-1.6-.1-4.7-.1Zm0 3.1a4.9 4.9 0 1 1 0 9.8 4.9 4.9 0 0 1 0-9.8Zm0 8a3.1 3.1 0 1 0 0-6.2 3.1 3.1 0 0 0 0 6.2Zm6.2-8.2a1.1 1.1 0 1 1-2.3 0 1.1 1.1 0 0 1 2.3 0Z"/></svg></a>{%- endif -%}
            {%- if settings.social_tiktok_link != blank -%}<a href="{{ settings.social_tiktok_link }}" aria-label="TikTok"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16.5 3c.4 2.3 1.7 3.8 4 4v2.7c-1.4.1-2.7-.3-4-1v6.6c0 4.2-3.4 6.7-6.9 5.6-3-.9-4.3-4.4-2.7-7.1 1.1-1.9 3.4-2.8 5.5-2.3v2.9c-.4-.1-.8-.2-1.2-.1-1.3.1-2.2 1.2-2 2.5.2 1.5 1.9 2.3 3.2 1.5.7-.5 1-1.2 1-2V3h3.8Z"/></svg></a>{%- endif -%}
            {%- if settings.social_pinterest_link != blank -%}<a href="{{ settings.social_pinterest_link }}" aria-label="Pinterest"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.6 19.3c-.1-.8-.1-2 .1-2.9l1.2-5s-.3-.6-.3-1.5c0-1.4.8-2.4 1.8-2.4.9 0 1.3.7 1.3 1.4 0 .9-.6 2.2-.9 3.4-.2 1 .5 1.8 1.5 1.8 1.8 0 3-2.3 3-5 0-2.1-1.4-3.6-3.9-3.6a4.5 4.5 0 0 0-4.7 4.5c0 .9.3 1.5.7 2 .2.2.2.3.1.6l-.2.9c-.1.3-.3.4-.6.2-1.3-.5-1.9-2-1.9-3.6 0-2.7 2.3-6 6.8-6 3.6 0 6 2.6 6 5.4 0 3.7-2 6.4-5 6.4-1 0-2-.5-2.3-1.2l-.6 2.4c-.2.8-.7 1.7-1 2.3A10 10 0 1 0 12 2Z"/></svg></a>{%- endif -%}
            {%- if settings.social_facebook_link != blank -%}<a href="{{ settings.social_facebook_link }}" aria-label="Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.3-1.5 1.6-1.5h1.6V3.6c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.4-4 4.1v2.3H6v3.1h2.3V21h5.2Z"/></svg></a>{%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <div class="bb-footer__col">
        <h4>{{ section.settings.col1_title }}</h4>
        <ul>
          {%- for i in (1..5) -%}
            {%- assign lbl = 'col1_link_' | append: i | append: '_label' -%}
            {%- assign lnk = 'col1_link_' | append: i | append: '_url' -%}
            {%- if section.settings[lbl] != blank -%}
              <li><a href="{{ section.settings[lnk] | default: '#' }}">{{ section.settings[lbl] }}</a></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      <div class="bb-footer__col">
        <h4>{{ section.settings.col2_title }}</h4>
        <ul>
          {%- for i in (1..5) -%}
            {%- assign lbl = 'col2_link_' | append: i | append: '_label' -%}
            {%- assign lnk = 'col2_link_' | append: i | append: '_url' -%}
            {%- if section.settings[lbl] != blank -%}
              <li><a href="{{ section.settings[lnk] | default: '#' }}">{{ section.settings[lbl] }}</a></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      <div class="bb-footer__col">
        <h4>{{ section.settings.about_title }}</h4>
        <p>{{ section.settings.about_text | newline_to_br }}</p>
      </div>
    </div>

    <div class="bb-footer__bar">
      <div>© {{ 'now' | date: '%Y' }} {{ section.settings.logo_text | default: shop.name }}. {{ section.settings.rights_text }}</div>
      <nav>
        {%- for policy in shop.policies -%}
          {%- if policy != blank -%}<a href="{{ policy.url }}">{{ policy.title }}</a>{%- endif -%}
        {%- endfor -%}
        {%- if section.settings.extra_legal_label != blank -%}
          <a href="{{ section.settings.extra_legal_url | default: '#' }}">{{ section.settings.extra_legal_label }}</a>
        {%- endif -%}
      </nav>
      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <div class="bb-footer__pay" style="display:flex;gap:6px;flex-wrap:wrap;align-items:center;">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'bb-pay-ico' }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "header", "content": "Brand column" },
    { "type": "image_picker", "id": "logo", "label": "Logo image (optional)" },
    { "type": "range", "id": "logo_width", "label": "Logo width (px)", "min": 80, "max": 260, "step": 10, "unit": "px", "default": 150 },
    { "type": "text", "id": "logo_text", "label": "Text logo", "default": "Bubble Beads" },
    { "type": "textarea", "id": "tagline", "label": "Tagline", "default": "Handmade beaded jewelry, hair essentials and surprise Bangle Boxes — curated with love." },
    { "type": "checkbox", "id": "show_social", "label": "Show social icons", "default": true },
    { "type": "header", "content": "Links column 1" },
    { "type": "text", "id": "col1_title", "label": "Title", "default": "Shop" },
    { "type": "text", "id": "col1_link_1_label", "label": "Link 1 text", "default": "Bangle Boxes" },
    { "type": "url", "id": "col1_link_1_url", "label": "Link 1 URL" },
    { "type": "text", "id": "col1_link_2_label", "label": "Link 2 text", "default": "Bracelets & Bangles" },
    { "type": "url", "id": "col1_link_2_url", "label": "Link 2 URL" },
    { "type": "text", "id": "col1_link_3_label", "label": "Link 3 text", "default": "Hair Essentials" },
    { "type": "url", "id": "col1_link_3_url", "label": "Link 3 URL" },
    { "type": "text", "id": "col1_link_4_label", "label": "Link 4 text", "default": "Collections" },
    { "type": "url", "id": "col1_link_4_url", "label": "Link 4 URL" },
    { "type": "text", "id": "col1_link_5_label", "label": "Link 5 text", "default": "Sale" },
    { "type": "url", "id": "col1_link_5_url", "label": "Link 5 URL" },
    { "type": "header", "content": "Links column 2" },
    { "type": "text", "id": "col2_title", "label": "Title", "default": "Help" },
    { "type": "text", "id": "col2_link_1_label", "label": "Link 1 text", "default": "Shipping" },
    { "type": "url", "id": "col2_link_1_url", "label": "Link 1 URL" },
    { "type": "text", "id": "col2_link_2_label", "label": "Link 2 text", "default": "Returns" },
    { "type": "url", "id": "col2_link_2_url", "label": "Link 2 URL" },
    { "type": "text", "id": "col2_link_3_label", "label": "Link 3 text", "default": "Track my order" },
    { "type": "url", "id": "col2_link_3_url", "label": "Link 3 URL" },
    { "type": "text", "id": "col2_link_4_label", "label": "Link 4 text", "default": "Contact us" },
    { "type": "url", "id": "col2_link_4_url", "label": "Link 4 URL" },
    { "type": "text", "id": "col2_link_5_label", "label": "Link 5 text", "default": "FAQ" },
    { "type": "url", "id": "col2_link_5_url", "label": "Link 5 URL" },
    { "type": "header", "content": "About column" },
    { "type": "text", "id": "about_title", "label": "Title", "default": "About Bubble Beads" },
    { "type": "textarea", "id": "about_text", "label": "Text", "default": "A dreamy little studio making colourful, high-quality bead jewelry you'll want to stack forever." },
    { "type": "header", "content": "Bottom bar" },
    { "type": "text", "id": "rights_text", "label": "Rights text", "default": "All rights reserved." },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true },
    { "type": "text", "id": "extra_legal_label", "label": "Extra legal link text (e.g. Cookies)" },
    { "type": "url", "id": "extra_legal_url", "label": "Extra legal link URL" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "margin_top", "label": "Space above footer (px)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_top", "label": "Space inside top (px)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Space inside bottom (px)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 }
  ]
}
{% endschema %}
