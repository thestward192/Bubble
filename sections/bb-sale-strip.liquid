{{ 'bb-styles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bb-scripts.js' | asset_url }}" defer></script>

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .bb-sale__title { font-size: {{ section.settings.heading_size }}px; }
{% endstyle %}

{%- assign bb_demos = 'bb-demo-3.jpg,bb-demo-4.jpg,bb-demo-hair2.jpg,bb-demo-7.jpg,bb-demo-5.jpg,bb-demo-8.jpg' | split: ',' -%}

<section class="bb-sale bb-section">
  <div class="bb-container">
    <div class="bb-sale__inner bb-reveal">
      <div class="bb-sale__copy">
        <h2 class="bb-sale__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="bb-sale__text">{{ section.settings.text }}</p>{%- endif -%}
      </div>

      <div class="bb-sale__items">
        {%- for block in section.blocks -%}
          <a class="bb-sale-card" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
            <span class="bb-sale-card__media">
              {% render 'bb-image', image: block.settings.image, label: 'Sale item', width: 300, fallback: bb_demos[forloop.index0] %}
            </span>
            <span class="bb-sale-card__price">
              {%- if block.settings.old_price != blank -%}<s>{{ block.settings.old_price }}</s>{%- endif -%}
              <b>{{ block.settings.new_price }}</b>
            </span>
          </a>
        {%- endfor -%}
      </div>

      {%- if section.settings.button_label != blank -%}
        <div class="bb-sale__cta">
          <a class="bb-btn bb-btn--pink" href="{{ section.settings.button_link | default: '#' }}">
            {{ section.settings.button_label }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "BB — Sale strip",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Last Chance Sparkle" },
    { "type": "text", "id": "text", "label": "Text", "default": "Grab your favorites before they're gone!" },
    { "type": "range", "id": "heading_size", "label": "Heading size (px)", "min": 18, "max": 48, "step": 1, "unit": "px", "default": 26 },
    { "type": "text", "id": "button_label", "label": "Button text", "default": "Shop Sale" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Space above (px)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Space below (px)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Sale item",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "old_price", "label": "Was price", "default": "€18.00" },
        { "type": "text", "id": "new_price", "label": "Now price", "default": "€12.60" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "BB — Sale strip",
      "blocks": [
        { "type": "item", "settings": { "old_price": "€18.00", "new_price": "€12.60" } },
        { "type": "item", "settings": { "old_price": "€16.00", "new_price": "€9.60" } },
        { "type": "item", "settings": { "old_price": "€22.00", "new_price": "€15.40" } },
        { "type": "item", "settings": { "old_price": "€14.00", "new_price": "€8.40" } }
      ]
    }
  ]
}
{% endschema %}
