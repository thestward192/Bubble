{{ 'bb-styles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bb-scripts.js' | asset_url }}" defer></script>

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    {% if section.settings.bg_color != blank %}background: {{ section.settings.bg_color }};{% endif %}
    position: relative;
    overflow-x: clip;
  }
  #shopify-section-{{ section.id }} .bb-cats__grid {
    grid-template-columns: repeat({{ section.settings.columns }}, minmax(0, 210px));
    justify-content: center;
  }
  #shopify-section-{{ section.id }} .bb-h2 { font-size: {{ section.settings.heading_size }}px; }
  #shopify-section-{{ section.id }} .bb-cat__name { font-size: {{ section.settings.label_size }}px; }
  @media (max-width: 1100px) {
    #shopify-section-{{ section.id }} .bb-cats__grid { grid-template-columns: repeat(3, minmax(0, 190px)); }
  }
  @media (max-width: 700px) {
    #shopify-section-{{ section.id }} .bb-h2 { font-size: {{ section.settings.heading_size | times: 0.78 | round }}px; }
  }
  @media (max-width: 640px) {
    #shopify-section-{{ section.id }} .bb-cats__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: 10px; }
    #shopify-section-{{ section.id }} .bb-cat__name { font-size: {{ section.settings.label_size | times: 0.78 | round }}px; }
    #shopify-section-{{ section.id }} .bb-cats__eyebrow { display: none; }
  }
{% endstyle %}

{%- assign bb_demos = 'bb-coll-1.jpg,bb-coll-2.jpg,bb-coll-4.jpg,bb-demo-hair.jpg,bb-coll-3.jpg,bb-demo-2.jpg,bb-demo-9.jpg,bb-demo-3.jpg' | split: ',' -%}

<section class="bb-cats bb-section">
  <div class="bb-cats__blob bb-cats__blob--1" aria-hidden="true">&nbsp;</div>
  <div class="bb-cats__blob bb-cats__blob--2" aria-hidden="true">&nbsp;</div>
  <div class="bb-container">
    <div class="bb-head bb-reveal">
      <div class="bb-head__title">
        {%- if section.settings.eyebrow != blank -%}
          <span class="bb-eyebrow bb-eyebrow--plain bb-cats__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- assign bb_heading_words = section.settings.heading | strip | split: ' ' -%}
        {%- assign bb_heading_word_count = bb_heading_words.size -%}
        <h2 class="bb-h2">
          {%- if bb_heading_word_count > 1 -%}
            {%- assign bb_heading_rest_count = bb_heading_word_count | minus: 1 -%}
            {{ bb_heading_words | slice: 0, bb_heading_rest_count | join: ' ' }} <em>{{ bb_heading_words | last }}</em>
          {%- else -%}
            {{ section.settings.heading }}
          {%- endif -%}
        </h2>
      </div>
      {%- if section.settings.view_all_label != blank -%}
        <a class="bb-btn bb-btn--link bb-cats__viewall" href="{{ section.settings.view_all_link | default: '#' }}">
          {{ section.settings.view_all_label }}
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      {%- endif -%}
    </div>

    <div class="bb-cats__grid">
      {%- for block in section.blocks -%}
        <a class="bb-cat bb-reveal" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
          <span class="bb-cat__panel">
            {% render 'bb-image', image: block.settings.image, label: block.settings.label, width: 600, fallback: bb_demos[forloop.index0] %}
          </span>
          <span class="bb-cat__name">{{ block.settings.label }}</span>
          {%- if block.settings.caption != blank -%}
            <span class="bb-cat__count">{{ block.settings.caption }}</span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "BB — Category tiles",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label above heading", "default": "Categories" },
    { "type": "text", "id": "heading", "label": "Section heading (last word is auto-colored)", "default": "Shop by Category" },
    { "type": "range", "id": "heading_size", "label": "Heading size (px)", "min": 20, "max": 60, "step": 2, "unit": "px", "default": 32 },
    { "type": "text", "id": "view_all_label", "label": "\"View all\" link text", "default": "View All Categories" },
    { "type": "url", "id": "view_all_link", "label": "\"View all\" link" },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 6, "step": 1, "default": 5 },
    { "type": "range", "id": "label_size", "label": "Card name size (px)", "min": 12, "max": 26, "step": 1, "unit": "px", "default": 17 },
    { "type": "color", "id": "bg_color", "label": "Section background", "default": "#FFFFFF" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Space above (px)", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Space below (px)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 28 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "label", "label": "Name", "default": "Category" },
        { "type": "text", "id": "caption", "label": "Small caption below the name", "default": "Explore" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "BB — Category tiles",
      "blocks": [
        { "type": "tile", "settings": { "label": "Bangle Boxes", "caption": "Curated sets" } },
        { "type": "tile", "settings": { "label": "Bracelets & Bangles", "caption": "Stack them up" } },
        { "type": "tile", "settings": { "label": "Necklaces", "caption": "New in" } },
        { "type": "tile", "settings": { "label": "Hair Essentials", "caption": "Clips & claws" } },
        { "type": "tile", "settings": { "label": "Sale", "caption": "Up to 40% off" } }
      ]
    }
  ]
}
{% endschema %}
