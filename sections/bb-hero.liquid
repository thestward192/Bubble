{{ 'bb-styles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bb-scripts.js' | asset_url }}" defer></script>

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .bb-hero { min-height: {{ section.settings.min_height }}vh; }
  #shopify-section-{{ section.id }} .bb-hero__fx { --bb-fx-holo-opacity: {{ section.settings.fx_holo_opacity | default: 38 | divided_by: 100.0 }}; }
  #shopify-section-{{ section.id }} .bb-hero__copy { text-align: {{ section.settings.text_align }}; }
  #shopify-section-{{ section.id }} .bb-hero__cta { justify-content: {% if section.settings.text_align == 'center' %}center{% elsif section.settings.text_align == 'right' %}flex-end{% else %}flex-start{% endif %}; }
  #shopify-section-{{ section.id }} .bb-eyebrow { {% if section.settings.text_align == 'center' %}margin-inline:auto;{% endif %} }
  #shopify-section-{{ section.id }} .bb-hero__text { {% if section.settings.text_align == 'center' %}margin-inline:auto;{% elsif section.settings.text_align == 'right' %}margin-left:auto;{% endif %} }
  #shopify-section-{{ section.id }} .bb-hero__title { font-size: {{ section.settings.heading_size }}px; }
  #shopify-section-{{ section.id }} .bb-hero__text { font-size: {{ section.settings.body_size }}px; }
  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} .bb-hero { min-height: 0; padding-top: 24px; padding-bottom: 44px; }
    #shopify-section-{{ section.id }} .bb-hero__title { font-size: {{ section.settings.heading_size | times: 0.62 | round }}px; }
  }
  @media (max-width: 480px) {
    #shopify-section-{{ section.id }} .bb-hero__title { font-size: {{ section.settings.heading_size | times: 0.5 | round }}px; }
    #shopify-section-{{ section.id }} .bb-hero__text { font-size: {{ section.settings.body_size | minus: 1 }}px; }
  }
  /* on large desktop screens the copy column has room to breathe: pull it in
     from the edge and size it up so it doesn't read as stranded on the left */
  @media (min-width: 1300px) {
    #shopify-section-{{ section.id }} .bb-hero__title { font-size: {{ section.settings.heading_size | times: 1.15 | round }}px; }
    #shopify-section-{{ section.id }} .bb-hero__text { font-size: {{ section.settings.body_size | plus: 1 }}px; }
  }

  /* --- ported hero visual styles (scoped copy from Bubble Beads (respaldo) bb-styles.css,
     kept inside this section file only so nothing else in the theme is touched) --- */
  .bb-hero .bb-eyebrow { gap: 6px; }
  .bb-hero .bb-eyebrow::before { display: none; }
  .bb-hero__title em { color: var(--bb-primary); font-style: italic; }
  body.bb-home .bb-hero__inner { padding-top: clamp(78px, 13vh, 150px); }
  @media (max-width: 989px) {
    /* the header sits in normal flow (not overlaid on the hero), so mobile only
       needs a small breathing gap here, not extra clearance for a floating header */
    body.bb-home .bb-hero__inner { padding-top: 12px; }
  }
  .bb-hero {
    position: relative;
    overflow-x: clip;
    display: flex;
    align-items: center;
    isolation: isolate;
  }
  .bb-hero > .bb-container { margin: 0; max-width: none; }
  .bb-hero--boxed { align-items: stretch; }
  .bb-hero::before {
    content: "";
    position: absolute; inset: 0;
    pointer-events: none;
    z-index: 0;
    background-image:
      radial-gradient(2px 2px at 12% 30%, #fff, transparent),
      radial-gradient(2px 2px at 68% 12%, #fff, transparent),
      radial-gradient(1.5px 1.5px at 84% 62%, #fff, transparent),
      radial-gradient(1.5px 1.5px at 40% 82%, #fff, transparent),
      radial-gradient(2px 2px at 26% 66%, #fff, transparent),
      radial-gradient(1.5px 1.5px at 55% 40%, #fff, transparent);
    opacity: 0.75;
  }
  .bb-hero--boxed::before { display: none; }
  .bb-hero__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 560px;
    padding: clamp(28px, 6vw, 64px) 0;
  }
  @media (min-width: 1300px) {
    .bb-hero__inner { max-width: 640px; }
    .bb-hero > .bb-container { padding-left: clamp(40px, 7vw, 120px); }
  }
  .bb-hero--boxed .bb-hero__inner {
    border-radius: var(--bb-radius);
    padding: clamp(34px, 6vw, 96px);
    background:
      radial-gradient(60% 80% at 80% 12%, rgba(248, 222, 236, 0.92), transparent 72%),
      radial-gradient(66% 92% at 10% 96%, rgba(210, 224, 248, 0.88), transparent 72%),
      linear-gradient(135deg, #E9DFF6 0%, #F0E4F0 55%, #E6DDF5 100%);
    box-shadow: var(--bb-shadow);
  }
  .bb-hero--boxed .bb-hero__inner::after {
    content: "";
    position: absolute; inset: 0;
    border-radius: inherit;
    pointer-events: none;
    z-index: 1;
    background-image:
      radial-gradient(2px 2px at 12% 26%, #fff, transparent),
      radial-gradient(2px 2px at 70% 14%, #fff, transparent),
      radial-gradient(1.5px 1.5px at 86% 60%, #fff, transparent),
      radial-gradient(1.5px 1.5px at 38% 84%, #fff, transparent),
      radial-gradient(2px 2px at 24% 68%, #fff, transparent);
    opacity: 0.8;
  }
  .bb-hero--boxed .bb-hero__copy, .bb-hero--boxed .bb-hero__visual { z-index: 3; }
  .bb-hero__copy { position: relative; z-index: 3; }
  .bb-hero__visual {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    width: min(46vw, 820px);
    overflow: hidden;
  }
  .bb-hero__media { position: absolute; inset: 0; }
  .bb-hero__media .bb-img, .bb-hero__media .bb-ph {
    width: 100%;
    height: 100%;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 46%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 46%);
  }
  .bb-hero__visual-wash {
    position: absolute;
    inset: 0 auto 0 0;
    width: 30%;
    background: linear-gradient(90deg, var(--bb-bg) 0%, rgba(236, 230, 246, 0) 100%);
    opacity: 0.55;
    pointer-events: none;
  }
  .bb-hero__fx {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
    pointer-events: none;
  }
  .bb-hero--boxed .bb-hero__fx { display: none; }
  .bb-hero__fx-base {
    position: absolute; inset: 0;
    background: linear-gradient(135deg, #faf7fd 0%, #fbf8fc 55%, #f8f9fe 100%);
  }
  .bb-hero__fx-holo {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    opacity: var(--bb-fx-holo-opacity, 0.04);
    mix-blend-mode: soft-light;
    filter: saturate(0.08) brightness(1.45) contrast(0.45);
  }
  .bb-hero__fx-sparkle {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    mix-blend-mode: screen;
  }
  .bb-hero__fx-sparkle--1 { display: none; }
  .bb-hero__fx-sparkle--2 { opacity: 0.09; transform: scale(1.25); filter: blur(0.8px); }
  .bb-hero__fx-veil {
    position: absolute; inset: 0;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.62) 0%,
      rgba(255, 255, 255, 0.62) 55%,
      rgba(255, 255, 255, 0.96) 100%
    );
  }
  .bb-hero__glow {
    position: absolute;
    border-radius: 9999px;
    filter: blur(80px);
    opacity: 0.4;
  }
  .bb-hero__glow--1 { top: -14%; left: -6%; width: 40vh; height: 40vh; background: rgba(201, 167, 236, 0.32); }
  .bb-hero__glow--2 { top: 12%; right: -8%; width: 44vh; height: 44vh; background: rgba(242, 182, 218, 0.26); }
  .bb-hero__glow--3 { bottom: -18%; left: 22%; width: 44vh; height: 44vh; background: rgba(169, 194, 240, 0.24); }
  .bb-hero__glow--4 { bottom: 6%; right: 16%; width: 30vh; height: 30vh; background: rgba(255, 255, 255, 0.3); }
  .bb-hero__bokeh {
    position: absolute;
    border-radius: 9999px;
    filter: blur(22px);
    opacity: 0.4;
  }
  .bb-hero__bokeh:nth-of-type(1) { top: 12%; left: 18%; width: 6rem; height: 6rem; background: radial-gradient(circle, rgba(255,255,255,0.6), transparent 70%); }
  .bb-hero__bokeh:nth-of-type(2) { top: 24%; left: 76%; width: 8rem; height: 8rem; background: radial-gradient(circle, rgba(233,212,247,0.5), transparent 70%); }
  .bb-hero__bokeh:nth-of-type(3) { top: 44%; left: 46%; width: 10rem; height: 10rem; background: radial-gradient(circle, rgba(255,255,255,0.42), transparent 70%); }
  .bb-hero__bokeh:nth-of-type(4) { top: 60%; left: 12%; width: 7rem; height: 7rem; background: radial-gradient(circle, rgba(247,212,234,0.5), transparent 70%); }
  .bb-hero__bokeh:nth-of-type(5) { top: 68%; left: 82%; width: 9rem; height: 9rem; background: radial-gradient(circle, rgba(212,226,247,0.46), transparent 70%); }
  .bb-hero__bokeh:nth-of-type(6) { top: 82%; left: 36%; width: 6rem; height: 6rem; background: radial-gradient(circle, rgba(255,255,255,0.46), transparent 70%); }
  .bb-hero__title {
    font-family: var(--bb-serif);
    font-weight: 600;
    line-height: 1.03;
    letter-spacing: -0.015em;
    margin: 18px 0 0;
  }
  .bb-hero__title .bb-accent { color: var(--bb-primary); font-style: italic; }
  .bb-hero__text { margin: 20px 0 0; max-width: 42ch; }
  .bb-hero__cta { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 30px; }
  .bb-hero__media .bb-ph { min-height: 260px; }
  .bb-hero__dot {
    position: absolute;
    z-index: 3;
    border-radius: 50%;
    box-shadow: 0 6px 14px -4px rgba(46, 39, 67, 0.35);
    animation: bb-float 6s var(--bb-ease) infinite;
  }
  .bb-hero__dot--1 { top: 4%; right: 10%; width: 22px; height: 22px; background: #F6D979; animation-delay: 0.2s; }
  .bb-hero__dot--2 { top: 42%; left: -6%; width: 14px; height: 14px; background: #A9DDEA; animation-delay: 1.1s; }
  .bb-hero__dot--3 { bottom: 12%; left: 30%; width: 16px; height: 16px; background: #F4B7C8; animation-delay: 2s; }
  .bb-hero__dot--4 { bottom: 30%; right: -4%; width: 18px; height: 18px; background: #C8B6F2; animation-delay: 0.6s; }
  .bb-hero__sparkle { position: absolute; z-index: 3; color: #fff; filter: drop-shadow(0 2px 6px rgba(46, 39, 67, 0.35)); }
  .bb-hero__sparkle--1 { top: 8%; right: -2%; width: 21px; height: 21px; }
  .bb-hero__sparkle--2 { bottom: 16%; left: -4%; width: 12px; height: 12px; }
  .bb-hero__sparkle svg { width: 100%; height: 100%; }
  .bb-hero__badge {
    position: absolute;
    top: 6%;
    right: -3%;
    z-index: 3;
    width: clamp(96px, 12vw, 132px);
    aspect-ratio: 1;
    border-radius: 50%;
    display: grid;
    place-content: center;
    text-align: center;
    padding: 14px;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(4px);
    box-shadow: var(--bb-shadow-sm);
    font: 600 10.5px/1.35 var(--bb-sans);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--bb-primary-deep);
    animation: bb-float 6s var(--bb-ease) infinite;
  }
  .bb-hero__visual-tag { display: none; }
  @media (max-width: 990px) {
    .bb-hero { flex-direction: column; }
    .bb-hero > .bb-container { order: 1; }
    .bb-hero__inner { max-width: 100%; }
    .bb-hero__copy, .bb-hero__cta { text-align: left; justify-content: flex-start; }
    .bb-hero__text { margin-inline: 0; }
    .bb-hero .bb-eyebrow {
      border: 1px solid var(--bb-line);
      border-radius: var(--bb-radius-pill);
      padding: 7px 16px 7px 12px;
      background: rgba(255, 255, 255, 0.55);
    }
    .bb-hero__visual {
      order: 2;
      align-self: center;
      position: relative; top: auto; right: auto; bottom: auto;
      width: calc(100% - 2 * var(--bb-gutter));
      overflow: visible;
      margin: 20px var(--bb-gutter) 0;
      height: 42vh; min-height: 260px;
      border-radius: var(--bb-radius);
      border: 6px solid #fff;
      box-shadow: var(--bb-shadow);
    }
    .bb-hero__media { border-radius: 16px; overflow: hidden; }
    .bb-hero__media .bb-img, .bb-hero__media .bb-ph { -webkit-mask-image: none; mask-image: none; }
    .bb-hero__visual-wash { display: none; }
    .bb-hero__visual-tag {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      position: absolute;
      top: 14px; left: 14px;
      z-index: 3;
      padding: 7px 14px 7px 10px;
      border-radius: var(--bb-radius-pill);
      background: rgba(255, 255, 255, 0.92);
      box-shadow: var(--bb-shadow-sm);
      font: 600 11px/1 var(--bb-sans);
      letter-spacing: 0.02em;
      text-transform: uppercase;
      color: var(--bb-primary-deep);
    }
    .bb-hero__visual-tag svg { width: 12px; height: 12px; color: var(--bb-primary); flex: none; }
    .bb-hero__badge {
      top: auto; left: auto; right: 14px; bottom: 14px;
      width: auto; aspect-ratio: auto;
      display: inline-flex; align-items: center; gap: 7px;
      padding: 9px 14px;
      border-radius: var(--bb-radius-pill);
      background: rgba(46, 39, 67, 0.88);
      backdrop-filter: none;
      box-shadow: var(--bb-shadow-sm);
      font: 600 11.5px/1 var(--bb-sans);
      letter-spacing: normal;
      text-transform: none;
      color: #fff;
      animation: none;
    }
    .bb-hero__badge::before {
      content: "";
      width: 7px; height: 7px; border-radius: 50%;
      background: #F4879B;
      box-shadow: 0 0 0 4px rgba(244, 135, 155, 0.28);
    }
    .bb-hero__dot--1 { top: -10px; left: auto; right: -10px; bottom: auto; width: 26px; height: 26px; }
    .bb-hero__dot--2 { display: none; }
    .bb-hero__dot--3 { top: 46%; left: -12px; right: auto; bottom: auto; width: 16px; height: 16px; }
    .bb-hero__dot--4 { bottom: -12px; left: 18%; right: auto; top: auto; width: 20px; height: 20px; }
    .bb-hero__sparkle--1, .bb-hero__sparkle--2 { display: none; }
  }
  @media (max-width: 640px) {
    .bb-hero__visual { height: 34vh; min-height: 210px; width: calc(100% - 32px); margin: 16px 16px 0; }
    .bb-hero__title { margin-top: 12px; }
    .bb-hero__text { margin-top: 14px; }
    .bb-hero__cta { width: 100%; gap: 10px; margin-top: 22px; }
    .bb-hero__cta .bb-btn { flex: 1 1 100%; justify-content: center; }
  }
  @media (max-width: 400px) {
    .bb-hero__visual { height: 28vh; min-height: 180px; width: calc(100% - 24px); margin: 14px 12px 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .bb-hero__badge { animation: none; }
    .bb-hero__fx-holo, .bb-hero__fx-sparkle--1, .bb-hero__glow, .bb-hero__bokeh { animation: none !important; }
  }
  .bb-eyebrow__icon { display: inline-flex; width: 13px; height: 13px; color: var(--bb-primary); flex: none; }
  .bb-eyebrow__icon svg { width: 100%; height: 100%; }
  .bb-btn__play {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    color: var(--bb-primary);
    flex: none;
  }
  .bb-btn__play svg { width: 9px; height: 9px; margin-left: 1px; }
  .bb-btn--ghost .bb-btn__play { background: var(--bb-primary-soft); color: #fff; }
{% endstyle %}

<section class="bb-hero bb-section{% unless section.settings.full_bleed %} bb-hero--boxed{% endunless %}{% if section.settings.show_fx %} bb-hero--has-fx{% endif %}">
  {%- if section.settings.show_fx -%}
    {%- assign fx_holo = section.settings.fx_holo -%}
    {%- assign fx_sparkle = section.settings.fx_sparkle -%}
    <div class="bb-hero__fx" aria-hidden="true">
      <div class="bb-hero__fx-base"></div>
      <img class="bb-hero__fx-holo" alt="" loading="eager"
           src="{% if fx_holo != blank %}{{ fx_holo | image_url: width: 2200 }}{% else %}{{ 'bb-hero-holo.jpg' | asset_url }}{% endif %}">
      <img class="bb-hero__fx-sparkle bb-hero__fx-sparkle--2" alt="" loading="eager"
           src="{% if fx_sparkle != blank %}{{ fx_sparkle | image_url: width: 2200 }}{% else %}{{ 'bb-hero-sparkle.jpg' | asset_url }}{% endif %}">
      <div class="bb-hero__fx-veil"></div>
      <div class="bb-hero__glow bb-hero__glow--1"></div>
      <div class="bb-hero__glow bb-hero__glow--2"></div>
      <div class="bb-hero__glow bb-hero__glow--3"></div>
      <div class="bb-hero__glow bb-hero__glow--4"></div>
      <div class="bb-hero__bokeh"></div>
      <div class="bb-hero__bokeh"></div>
      <div class="bb-hero__bokeh"></div>
      <div class="bb-hero__bokeh"></div>
      <div class="bb-hero__bokeh"></div>
      <div class="bb-hero__bokeh"></div>
    </div>
  {%- endif -%}
  <div class="bb-hero__visual" aria-hidden="true">
    <div class="bb-hero__media">
      {% render 'bb-image', image: section.settings.image, label: 'Hero image', width: 1600, eager: true, fallback: section.settings.demo_image %}
    </div>
    <div class="bb-hero__visual-wash"></div>
    {%- if section.settings.eyebrow != blank -%}
      <span class="bb-hero__visual-tag">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2c.6 3.6 1.8 6.2 3.6 8s4.4 3 8 3.6c-3.6.6-6.2 1.8-8 3.6s-3 4.4-3.6 8c-.6-3.6-1.8-6.2-3.6-8s-4.4-3-8-3.6c3.6-.6 6.2-1.8 8-3.6s3-4.4 3.6-8z"/></svg>
        {{ section.settings.eyebrow }}
      </span>
    {%- endif -%}
    {%- if section.settings.badge_text != blank -%}
      <div class="bb-hero__badge">{{ section.settings.badge_text }}</div>
    {%- endif -%}
    {%- if section.settings.show_dots -%}
      <span class="bb-hero__dot bb-hero__dot--1" aria-hidden="true"></span>
      <span class="bb-hero__dot bb-hero__dot--2" aria-hidden="true"></span>
      <span class="bb-hero__dot bb-hero__dot--3" aria-hidden="true"></span>
      <span class="bb-hero__dot bb-hero__dot--4" aria-hidden="true"></span>
      <span class="bb-hero__sparkle bb-hero__sparkle--1" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2c.6 3.6 1.8 6.2 3.6 8s4.4 3 8 3.6c-3.6.6-6.2 1.8-8 3.6s-3 4.4-3.6 8c-.6-3.6-1.8-6.2-3.6-8s-4.4-3-8-3.6c3.6-.6 6.2-1.8 8-3.6s3-4.4 3.6-8z"/></svg></span>
      <span class="bb-hero__sparkle bb-hero__sparkle--2" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2c.6 3.6 1.8 6.2 3.6 8s4.4 3 8 3.6c-3.6.6-6.2 1.8-8 3.6s-3 4.4-3.6 8c-.6-3.6-1.8-6.2-3.6-8s-4.4-3-8-3.6c3.6-.6 6.2-1.8 8-3.6s3-4.4 3.6-8z"/></svg></span>
    {%- endif -%}
  </div>

  <div class="bb-container">
    <div class="bb-hero__inner bb-reveal">
      <div class="bb-hero__copy">
        {%- if section.settings.eyebrow != blank -%}
          <span class="bb-eyebrow">
            <span class="bb-eyebrow__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2c.6 3.6 1.8 6.2 3.6 8s4.4 3 8 3.6c-3.6.6-6.2 1.8-8 3.6s-3 4.4-3.6 8c-.6-3.6-1.8-6.2-3.6-8s-4.4-3-8-3.6c3.6-.6 6.2-1.8 8-3.6s3-4.4 3.6-8z"/></svg></span>
            {{ section.settings.eyebrow }}
          </span>
        {%- endif -%}
        <h1 class="bb-hero__title">{{ section.settings.title }}</h1>
        {%- if section.settings.text != blank -%}
          <p class="bb-hero__text bb-lead">{{ section.settings.text | newline_to_br }}</p>
        {%- endif -%}
        <div class="bb-hero__cta">
          {%- if section.settings.button_label != blank -%}
            <a class="bb-btn" href="{{ section.settings.button_link | default: '#' }}">
              {{ section.settings.button_label }}
            </a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a class="bb-btn bb-btn--ghost" href="{{ section.settings.button_link_2 | default: '#' }}">
              <span class="bb-btn__play" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
              {{ section.settings.button_label_2 }}
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "BB — Hero",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label above title", "default": "Handmade, with intention" },
    { "type": "inline_richtext", "id": "title", "label": "Title (make one word italic for the accent colour)", "default": "Collect a little bit of <em>magic</em>." },
    { "type": "textarea", "id": "text", "label": "Paragraph", "default": "One-of-a-kind handmade pieces to carry your mood with you. Discover them online or come pick your favorite at our next live." },
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "demo_image", "label": "Demo image file (shown until you pick your own)", "info": "Clear this field to show an empty placeholder instead.", "default": "bb-hero-bracelet-hearts.jpg" },
    { "type": "text", "id": "badge_text", "label": "Floating badge text", "info": "Leave blank to hide the floating badge." },
